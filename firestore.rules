// ALLOWED_EMAIL "paul.a.adeogun@gmail.com" is hardcoded in two places below.
// Also defined in src/App.jsx:52 and functions/index.js:11 — update all three together.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email == "paul.a.adeogun@gmail.com";
    }
    match /marketStats/{district} {
      allow read: if request.auth != null
        && request.auth.token.email == "paul.a.adeogun@gmail.com";
      allow write: if false;
    }
    match /mail/{id} {
      allow read, write: if false;
    }
  }
}
