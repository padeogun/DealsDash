{
  "name": "dealsdash",
  "version": "1.0.0",
  "description": "DealsDash — property deal and business cash flow dashboard",
  "private": true,
  "scripts": {
    "build:js": "esbuild src/main.jsx --bundle --format=iife --outfile=public/bundle.js --minify --loader:.js=jsx --loader:.png=dataurl --define:process.env.NODE_ENV='\"production\"'",
    "build:css": "tailwindcss -i src/tailwind-input.css -o public/styles.css --minify",
    "build": "npm run build:css && npm run build:js",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules,storage,functions",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:hosting": "npm run build && firebase deploy --only hosting,firestore:rules",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^19.3.0",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^2.1.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "esbuild": "^0.27.7",
    "firebase-admin": "^14.5.0",
    "tailwindcss": "^3.4.19",
    "vitest": "^3.2.7",
    "xlsx": "^0.18.5"
  }
}
